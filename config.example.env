# Copy to /etc/oc-reserve/config.env (chmod 600). Shell syntax; quote values with spaces.

# --- OCI access (standard OCI CLI config file + its API key) ---
OCI_CONFIG_FILE=/etc/oc-reserve/oci_config
COMPARTMENT_ID=ocid1.tenancy.oc1..xxxx      # tenancy OCID = root compartment

# --- What to reserve ---
# Regions, comma separated, tried in order. With ENFORCE_FREE_TIER=true only the home region is used.
REGIONS=us-sanjose-1
# Shapes, comma separated, tried in order. Format shape:ocpus:memGB (leave ocpus/mem empty for fixed shapes).
SHAPES=VM.Standard.A1.Flex:2:12,VM.Standard.E2.1.Micro::
INSTANCE_NAME=my-instance
IMAGE_OS="Canonical Ubuntu"
IMAGE_OS_VERSION=24.04
BOOT_GB=200
SSH_PUBKEY_FILE=/etc/oc-reserve/ssh_key.pub   # OpenSSH format (ssh-rsa / ssh-ed25519 ...)

# --- Network: reuse a public subnet with this name, otherwise a VCN+subnet is created ---
SUBNET_NAME=

# --- Behaviour ---
ENFORCE_FREE_TIER=true        # refuse non-home regions, non-free shapes, >2 OCPU/12 GB A1, >200 GB boot
STOP_AFTER_SUCCESS=true
TIMER_UNIT=oc-reserve.timer   # disabled automatically after success
STATE_DIR=/var/lib/oc-reserve

# --- Cadence (used by install.sh when writing the timer) ---
INTERVAL_MINUTES=5

# --- Optional notifications (leave NTFY_TOPIC empty to disable). ntfy topics are PUBLIC. ---
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
